
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Order {
  id         String      @id @default(cuid())
  status     OrderStatus @default(PENDING)
  totalNet   Float
  totalGross Float
  sapOrderNumber  String? // sap order number if status is CONFIRMED
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id       String  @id @default(cuid())
  name     String
  quantity Int
  price    Float
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}